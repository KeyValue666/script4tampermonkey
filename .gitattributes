# 统一换行符，避免 Windows / macOS 之间产生整文件 diff
* text=auto eol=lf

*.user.js text eol=lf
*.md      text eol=lf
*.json    text eol=lf

# Windows 脚本保持 CRLF，避免 PowerShell 解析异常
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# 图片按二进制处理
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
